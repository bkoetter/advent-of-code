[Unit]
Description=Download latest SAP Cloud Connector if a newer version exists
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The script's shebang points at /opt/python/current/bin/python3.15
ExecStart=/usr/local/sbin/sapcc-update
Nice=10
IOSchedulingClass=idle
# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/sapcc-download
CapabilityBoundingSet=
