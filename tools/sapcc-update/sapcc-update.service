[Unit]
Description=Download latest SAP Cloud Connector if a newer version exists
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The script's shebang points at /usr/bin/python3.11
ExecStart=/usr/local/sbin/sapcc-update
Nice=10
IOSchedulingClass=idle
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# Default base dir is /tmp/sapcc-update. PrivateTmp= must stay off, or the
# downloads would vanish when the service stops. To use another directory,
# add --base-dir to ExecStart and change ReadWritePaths= to match.
ReadWritePaths=/tmp
CapabilityBoundingSet=
